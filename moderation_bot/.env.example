# --- Обязательное ---------------------------------------------------------
# Токен от @BotFather (команда /newbot). Значение ниже — заглушка:
# бот откажется стартовать, пока вы не вставите настоящий токен.
BOT_TOKEN=123456789:REPLACE_WITH_YOUR_TOKEN_FROM_BOTFATHER

# --- Фильтры (значения по умолчанию можно поменять здесь) -----------------
# Кого блокировать: @username без @ (в Telegram юзернейм не зависит от регистра).
TARGET_USERNAME=zaztagbot
# Запрещённый хэштег: ищем в тексте и в подписи к медиа (пробелы не важны: "# реклама" тоже ловится).
BANNED_HASHTAG=#реклама

# --- Поведение ------------------------------------------------------------
# Отвечать ли в чат на срабатывание фильтра (само сообщение удаляется всегда).
# Ответ бота автоматически удаляется через NOTICE_TTL_SECONDS секунд.
NOTIFY_ON_DELETE=true
# Подробные логи удалённых сообщений в консоль (true/false).
VERBOSE_LOG=true
# Ограничить работу бота одной группой. Пусто = бот работает во всех группах,
# куда его добавили (у каждой группы свои настройки).
ALLOWED_CHAT_ID=
# Сколько секунд кэшировать проверку «админ ли автор» (0 = не кэшировать).
ADMIN_CACHE_TTL=300

# --- База данных ----------------------------------------------------------
# Относительный путь считается от каталога moderation_bot.
DB_PATH=data/moderation.sqlite3

# --- Аудит (необязательно) ------------------------------------------------
# Складывать копии удалённых сообщений в отдельный канал/чат (нужен ID, например -1001234567890).
FORWARD_DELETED_TO_LOG=false
LOG_CHAT_ID=
